# Database Configuration (Optional local Postgres)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Firebase Configuration (Cloud Firestore)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Recruiter Notification Settings
NOTIFICATION_EMAIL=recruiter@example.com

# Recruiter WhatsApp Dispatch Number (with country code, e.g. 919398113504)
NEXT_PUBLIC_WHATSAPP_RECRUITER_NUMBER=919398113504
WHATSAPP_RECRUITER_NUMBER=919398113504

# Optional: Email Dispatcher (Gmail App Password or Resend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# RESEND_API_KEY=

# Secret 6-Digit Backend Portal PIN (Stored only in local .env, NEVER in code)
ADMIN_PORTAL_PIN=123456

