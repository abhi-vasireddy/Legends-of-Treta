.kingdom-divider__line{width:1px;height:80px;background:linear-gradient(to bottom,transparent,#d4a853,transparent);opacity:0.4}
.kingdom-divider__dot{position:absolute;width:6px;height:6px;border-radius:50%;background:#d4a853;box-shadow:0 0 12px rgba(212,168,83,0.5)}

/* Floating particles */
.kingdom-particles{position:absolute;inset:0;z-index:1;pointer-events:none;overflow:hidden}
.kingdom-particle{position:absolute;width:3px;height:3px;background:rgba(212,168,83,0.5);border-radius:50%;animation:float-up linear infinite}
@keyframes float-up{0%{transform:translateY(100vh) scale(0);opacity:0}10%{opacity:1}90%{opacity:0.8}100%{transform:translateY(-10vh) scale(1.5);opacity:0}}
@keyframes pulse-glow{0%,100%{box-shadow:0 0 8px #d4a853,0 0 20px rgba(212,168,83,0.4)}50%{box-shadow:0 0 16px #d4a853,0 0 40px rgba(212,168,83,0.6)}}

/* Progress bar for kingdom scroll */
.kingdom-progress{position:fixed;top:0;left:0;width:0%;height:3px;background:linear-gradient(to right,#d4a853,#e8c065);z-index:9999;transition:width 0.1s linear;box-shadow:0 0 10px rgba(212,168,83,0.6);pointer-events:none;opacity:0;transition:width 0.1s linear,opacity 0.3s ease}
.kingdom-progress.active{opacity:1}

/* Side chapter nav for kingdom */
.kingdom-chapters{position:fixed;right:24px;top:50%;transform:translateY(-50%);z-index:100;display:flex;flex-direction:column;gap:16px;opacity:0;transition:opacity 0.4s ease;pointer-events:none}
.kingdom-chapters.active{opacity:1;pointer-events:auto}
.kingdom-chapters__dot{width:10px;height:10px;border-radius:50%;border:2px solid rgba(212,168,83,0.3);background:transparent;cursor:pointer;transition:all 0.3s ease;position:relative}
.kingdom-chapters__dot.active{background:#d4a853;border-color:#d4a853;box-shadow:0 0 10px rgba(212,168,83,0.5)}
.kingdom-chapters__dot::after{content:attr(data-label);position:absolute;right:22px;top:50%;transform:translateY(-50%);font-family:'Barlow',sans-serif;font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#d4a853;white-space:nowrap;opacity:0;transition:opacity 0.3s ease;pointer-events:none}
.kingdom-chapters__dot:hover::after{opacity:1}

/* Horizontal scroll strip between panels 3 & 4 */
.kingdom-strip{height:220px;overflow:hidden;background:#0a0a08;position:relative}
.kingdom-strip__track{display:flex;gap:0;height:100%;animation:scroll-strip 30s linear infinite}
.kingdom-strip__img{height:100%;width:auto;flex-shrink:0;filter:brightness(0.5) sepia(0.3);opacity:0.6}
@keyframes scroll-strip{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}

@media(max-width:760px){
  .kingdom-panel__title{letter-spacing:-1px}
  .kingdom-chapters{display:none}
  .kingdom-strip{height:140px}
}
