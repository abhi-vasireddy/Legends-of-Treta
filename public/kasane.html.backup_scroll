  set(a,b){tx=clamp(a);ty=clamp(b)},
  reset(){tx=ty=x=y=0},
  step(dt,p,enabled=true){
   if(!enabled){tx=ty=x=y=0;return{x:0,y:0,weight:0}}
   const a=1-Math.exp(-Math.max(0,Math.min(.05,dt))*6.5);x+=(tx-x)*a;y+=(ty-y)*a;
   const gateClearance=1-.4*smooth(.35,.5,p)*(1-smooth(.64,.73,p));
   const weight=gateClearance*(1-smooth(.79,.96,p));
   return{x:x*weight,y:y*weight,weight};
  }
 };
};

