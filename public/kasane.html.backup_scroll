<script>
/* ── Kingdom Scroll Engine ── */
(function(){
  const journey = document.querySelector('.kingdom-journey');
  if (!journey) return;
  const panels = journey.querySelectorAll('.kingdom-panel');
  const progressBar = document.getElementById('kingdom-progress');
  const chaptersNav = document.getElementById('kingdom-chapters');
  const dots = chaptersNav ? chaptersNav.querySelectorAll('.kingdom-chapters__dot') : [];

  /* Parallax backgrounds */
  function parallax(){
    panels.forEach(panel => {
      const bg = panel.querySelector('.kingdom-panel__bg');
      if (!bg) return;
      const rect = panel.getBoundingClientRect();
      const vh = window.innerHeight;
      if (rect.top < vh && rect.bottom > 0){
        const progress = (vh - rect.top) / (vh + rect.height);
        bg.style.transform = 'translateY(' + ((progress - 0.5) * 80) + 'px) scale(1.08)';
      }
    });
  }

  /* IntersectionObserver for reveal */
  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (entry.isIntersecting){
        entry.target.classList.add('is-visible');
        const idx = entry.target.dataset.panelIndex;
        if (idx !== undefined){
          dots.forEach(d => d.classList.remove('active'));
          const activeDot = chaptersNav.querySelector('[data-panel="'+idx+'"]');
          if (activeDot) activeDot.classList.add('active');
        }
      }
    });
  }, { threshold: 0.3 });
  panels.forEach(p => observer.observe(p));

  /* Kingdom section progress bar & chapter nav visibility */
  function updateProgress(){
    const rect = journey.getBoundingClientRect();
    const vh = window.innerHeight;
    const total = journey.offsetHeight;
    const scrolled = Math.max(0, -rect.top);
    const pct = Math.min(100, (scrolled / (total - vh)) * 100);

    const inKingdom = rect.top < vh && rect.bottom > 0;
    if (progressBar) {
      progressBar.style.width = pct + '%';
      progressBar.classList.toggle('active', inKingdom);
    }
    if (chaptersNav) chaptersNav.classList.toggle('active', inKingdom);
  }

  /* Floating particles */
  journey.querySelectorAll('.kingdom-particles').forEach(container => {
    for (let i = 0; i < 20; i++){
      const p = document.createElement('div');
      p.className = 'kingdom-particle';
      p.style.left = Math.random() * 100 + '%';
      p.style.animationDuration = (6 + Math.random() * 10) + 's';
      p.style.animationDelay = Math.random() * 8 + 's';
      p.style.width = p.style.height = (2 + Math.random() * 3) + 'px';
      container.appendChild(p);
    }
  });

  /* Dot navigation clicks */
  dots.forEach(dot => {
    dot.addEventListener('click', () => {
      const idx = dot.dataset.panel;
      const target = journey.querySelector('[data-panel-index="'+idx+'"]');
      if (target) target.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  });

  /* Scroll listeners */
  let ticking = false;
  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(() => { parallax(); updateProgress(); ticking = false; });
      ticking = true;
    }
  }, { passive: true });

  parallax();
  updateProgress();
})();
</script>

